# =============================================================================
# Storefront Environment Configuration (Feature 18)
# =============================================================================
# Copy this file to .env.local and fill in the values.

# =============================================================================
# Server-side only (never prefix with NEXT_PUBLIC_)
# Used by server components and /api/proxy/* route handlers.
# =============================================================================
MERCHANT_API_URL=http://localhost:8000
# Must match the merchant's MERCHANT_API_KEY
MERCHANT_API_KEY=merchant-api-key-12345
PSP_API_URL=http://localhost:8001
# Must match the PSP's PSP_API_KEY
PSP_API_KEY=psp-api-key-12345

# Phase 2+: Apps SDK MCP server (recommendations, search)
MCP_SERVER_URL=http://localhost:2091
# Phase 4: HMAC secret for POST /api/webhooks/acp; must match the merchant's
# WEBHOOK_SECRET. If unset, every webhook is rejected (HTTP 500).
# The merchant's WEBHOOK_URL (comma-separated) must include this receiver, e.g.
# WEBHOOK_URL=http://localhost:3000/api/webhooks/acp,http://localhost:3002/api/webhooks/acp
WEBHOOK_SECRET=whsec_demo_secret

# Chat LLM. Azure OpenAI Responses API is used when key + base URL are set;
# otherwise NIM's OpenAI-compatible API. Leave both keys empty to force the
# deterministic fallback router.
# e.g. https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-5.3-codex
# minimal | low | medium | high
CHAT_LLM_REASONING_EFFORT=low
# Set to "nim" to ignore the Azure settings
# CHAT_LLM_PROVIDER=nim
NVIDIA_API_KEY=
NIM_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_LLM_MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b
# Tool calls per chat turn (1-10)
CHAT_MAX_TOOL_STEPS=6
# Per LLM request (1000-120000); defaults: 60000 Azure, 20000 NIM.
# On timeout the keyword router answers.
# CHAT_LLM_TIMEOUT_MS=60000

# =============================================================================
# Client-side safe
# =============================================================================
NEXT_PUBLIC_API_VERSION=2026-01-16
NEXT_PUBLIC_BRAND_NAME="Visit Dubai"
# Phase 2: prefill the PSP test card on /checkout
NEXT_PUBLIC_DEMO_PREFILL=true
